#!/usr/bin/env bash
set -euo pipefail

MODE="debug"
ENGINE="cluster"
DURATION_SECS=60
WORKLOAD="balanced"
ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --release)
      MODE="release"
      ARGS+=("$1")
      shift
      ;;
    --debug)
      MODE="debug"
      ARGS+=("$1")
      shift
      ;;
    --engine)
      ENGINE="${2:-cluster}"
      ARGS+=("$1" "$ENGINE")
      shift 2
      ;;
    --workload|--profile)
      WORKLOAD="${2:-balanced}"
      ARGS+=("$1" "$WORKLOAD")
      shift 2
      ;;
    --duration-secs)
      DURATION_SECS="${2:-60}"
      ARGS+=("$1" "$DURATION_SECS")
      shift 2
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

echo "Running loadtest in $MODE mode with engine=$ENGINE..."

if [[ "$MODE" == "release" ]]; then
  ./cargow build --release
else
  ./cargow build
fi

KEYFILE=/tmp/evfs-loadtest-master.key
dd if=/dev/urandom of="$KEYFILE" bs=32 count=1 status=none

cd loadtest

SQLSHIM_LIB="../sqlshim/target/$MODE/libsqlshim.so"
CMD=("./target/$MODE/loadtest" "${ARGS[@]}")
APP_TIMEOUT_SECS=$((DURATION_SECS * 2 + 30))
RUN_MULTIPLIER=1
if [[ "$WORKLOAD" == "all" ]]; then
  RUN_MULTIPLIER=$((RUN_MULTIPLIER * 6))
fi
if [[ "$ENGINE" == "all" ]]; then
  RUN_MULTIPLIER=$((RUN_MULTIPLIER * 3))
fi
APP_TIMEOUT_SECS=$((APP_TIMEOUT_SECS * RUN_MULTIPLIER))
RUN_CMD=(timeout "$APP_TIMEOUT_SECS" "${CMD[@]}")

if [[ "$ENGINE" == "sqlite" || "$ENGINE" == "baseline" ]]; then
  "${RUN_CMD[@]}"
else
  EVFS_KEYFILE="$KEYFILE" \
    LD_PRELOAD="$SQLSHIM_LIB" \
    RUST_BACKTRACE=full \
    RUST_LIB_BACKTRACE=1 \
    "${RUN_CMD[@]}"
fi
